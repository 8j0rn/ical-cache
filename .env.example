# .env.example
# Копируйте этот файл в .env и заполните своими значениями

# БАЗА ДАННЫХ
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wordpress_db
DB_USER=wordpress_user
DB_PASS=your_password_here

# WORDPRESS
WP_URL=https://your-domain.ru
ICAL_ENDPOINT=/ical-feed?ical=

# АУТЕНТИФИКАЦИЯ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# НАСТРОЙКИ КЭШИРОВАНИЯ
CACHE_MAX_AGE=3600
CACHE_CLEANUP_DAYS=7
CACHE_MAX_SIZE_MB=100

# ПУБЛИЧНЫЕ ПУТИ
PUBLIC_PATHS=/ical/,/health/,/public/

# ЛОГИРОВАНИЕ
LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log
LOG_MAX_SIZE=10
LOG_BACKUP_COUNT=5

# СИНХРОНИЗАЦИЯ
SYNC_BATCH_SIZE=10
SYNC_DELAY=0.5
SYNC_TIMEOUT=30

# ВЕБ-СЕРВЕР
HOST=0.0.0.0
PORT=8000
DEBUG=false